# Keep the independently established Ramnit/Tinba regression vectors available
# to the permanent production-path tests; all other validation material remains local.
!/validation/
/validation/*
!/validation/dga_reference_validation/
/validation/dga_reference_validation/*
!/validation/dga_reference_validation/vectors/
/validation/dga_reference_validation/vectors/*
!/validation/dga_reference_validation/vectors/ramnit_reference_raw.json
!/validation/dga_reference_validation/vectors/tinba_reference_raw.json
validation/dga_reference_validation/vectors/tinba_reference_raw.json
validation/dga_reference_validation/vectors/ramnit_reference_raw.json
